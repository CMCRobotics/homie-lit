{
  "name": "@cmcrobotics/homie-lit",
  "version": "0.8.0",
  "description": "A TypeScript library integrating Homie devices with DOM element attributes for visualization",
  "repository": "github:cmcrobotics/homie-lit",
  "main": "dist/homie-lit.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "bun run server.ts",
    "build": "bun run build.ts",
    "prepare": "bun run build",
    "test": "bun test",
    "test:integration": "bun test --timeout 5000 integrationtest",
    "test:all": "bun test",
    "demo:aframe": "bun run build && bun run server.ts --aframe",
    "demo:html": "bun run build && bun run server.ts"
  },
  "keywords": [
    "homie",
    "lit-html",
    "typescript",
    "iot"
  ],
  "module": "dist/homie-lit.esm.js",
  "browser": "dist/homie-lit.js",
  "exports": {
    ".": {
      "import": "./dist/homie-lit.esm.js",
      "require": "./dist/homie-lit.js",
      "browser": "./dist/homie-lit.js"
    },
    "./core": {
      "import": "./dist/homie-lit.core.js",
      "require": "./dist/homie-lit.core.js",
      "default": "./dist/homie-lit.core.js"
    }
  },
  "author": "Brice Copy",
  "license": "MIT",
  "devDependencies": {
    "@types/mqtt": "^0.0.34",
    "@types/node": "^16.11.12",
    "dotenv": "^16.4.5",
    "typescript": "^4.5.4"
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "lit": "^2.6.1",
    "loglevel": "^1.9.2",
    "rxjs": "^7.8.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
